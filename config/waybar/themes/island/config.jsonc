// ──────────────────────────────────────────────
//   Waybar — ISLAND theme (niri port)
//   origin: okyashgajjar/low-sepecs-hyprland-dotfiles
// ──────────────────────────────────────────────
{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "height": 44,
    "margin-top": 10,
    "margin-bottom": 0,
    "margin-left": 100,
    "margin-right": 100,

    "modules-left": [
        "custom/launcher",
        "niri/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "custom/updates",
        "custom/screenoff",
        "custom/theme",
        "custom/wall",
        "custom/power"
    ],

    // ── Modules ─────────────────────────────────

    "custom/launcher": {
        "format": "󰣇",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "clock": {
        "format": "{:%a, %d %b | %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month"
        }
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "network": {
        "interval": 10,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "󰤨  {essid}\n󱑽  {signalStrength}%\n󰩟  {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "No connection — click to open menu",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 60,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    },

    "custom/updates": {
        "format": "\udb81\udeb0  {}",
        "escape": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 3600,
        "on-click": "kitty -e yay -Syu; pkill -RTMIN+8 waybar",
        "signal": 8
    },

    "custom/screenoff": {
        "format": "󰽥",
        "tooltip": "screen off now (auto after 5 min idle)",
        "on-click": "rice-screenoff"
    },
    "custom/theme": {
        "format": "󰏘",
        "tooltip": "theme: click = cycle, right-click = picker",
        "on-click": "rice-theme-switch next",
        "on-click-right": "rice-theme-switch menu"
    },
    "custom/wall": {
        "format": "󰋎",
        "tooltip": "wallpaper: click next, right-click pick",
        "on-click": "rice-wallpaper next",
        "on-click-right": "rice-wallpaper pick"
    }
}
