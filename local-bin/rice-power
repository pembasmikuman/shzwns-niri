#!/usr/bin/env bash
# rice-power — wlogout power menu, themed
set -u
CONF="$HOME/.config/niri-rice/active.conf"
[ -f "$CONF" ] || CONF="$HOME/.config/niri-rice/themes/gruvbox.conf"
# shellcheck disable=SC1090
source "$CONF"

BG_HEX="${BG#\#}"
R=$((16#${BG_HEX:0:2})) G=$((16#${BG_HEX:2:2})) B=$((16#${BG_HEX:4:2}))
ICONS=/usr/share/wlogout/icons
CSS=/tmp/rice-wlogout.css
cat > "$CSS" <<EOF
* { background-image: none; box-shadow: none; }
window { background-color: rgba(${R}, ${G}, ${B}, 0.88); }
button {
    color: ${TEXT};
    background-color: ${SURFACE};
    border: 2px solid ${BORDER};
    border-radius: 16px;
    margin: 14px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 22%;
}
button:focus, button:active, button:hover {
    background-color: ${SURFACE2};
    border-color: ${ACCENT};
    outline-style: none;
}
#lock       { background-image: url("${ICONS}/lock.png"); }
#logout     { background-image: url("${ICONS}/logout.png"); }
#suspend    { background-image: url("${ICONS}/suspend.png"); }
#hibernate  { background-image: url("${ICONS}/hibernate.png"); }
#shutdown   { background-image: url("${ICONS}/shutdown.png"); }
#reboot     { background-image: url("${ICONS}/reboot.png"); }
EOF

exec wlogout -C "$CSS" -b 6 \
    -l "$HOME/.config/niri-rice/wlogout-layout.json"
